      {/* Outer macOS Window Frame */}
      <div className="w-full h-full max-w-[1700px] bg-[#14161b]/90 backdrop-blur-2xl border border-white/10 rounded-xl shadow-2xl flex flex-col overflow-hidden text-sm relative">
        
        {/* Title Bar */}
        <header className="h-12 bg-[#191b21]/80 backdrop-blur-md border-b border-white/5 flex items-center justify-between px-4 z-20">
          <div className="flex items-center space-x-4">
            <div className="flex items-center space-x-2">
              <button title="Close" className="w-3 h-3 rounded-full bg-[#ff5f56] hover:bg-[#ff5f56]/80 flex items-center justify-center group transition">
