    { name: 'unit1.pas', type: 'pascal', icon: Icons.FileCode, path: 'unit1.pas', badge: 'Active' },
    { name: 'unit1.lfm', type: 'form', icon: Icons.FileCode, path: 'unit1.lfm' },
    { name: 'ideas.sqlite3', type: 'db', icon: Icons.Database, path: 'ideas.sqlite3' },
  ];

  useEffect(() => {
    terminalEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [terminalHistory]);

  const handleCommandSubmit = (e) => {
    e.preventDefault();
    if (!currentCommand.trim()) return;

    const cmd = currentCommand.trim();
    const newHist = [...terminalHistory, { text: `richardleurs@Mac-mini db-demo % ${cmd}`, type: 'command' }];

    if (cmd === 'clear') {
      setTerminalHistory([]);
    } else if (cmd === 'ls' || cmd === 'dir') {
      newHist.push({ text: 'DbDemo.lpr  unit1.pas  unit1.lfm  ideas.sqlite3  lib/', type: 'info' });
      setTerminalHistory(newHist);
    } else if (cmd.startsWith('fpc') || cmd === 'build') {
      newHist.push({ text: 'Compiling project target...', type: 'info' });
      newHist.push({ text: 'Success: 0 Errors, 0 Warnings.', type: 'success' });
      setTerminalHistory(newHist);
    } else if (cmd === 'help') {
      newHist.push({ text: 'Available commands: fpc, build, ls, clear, help', type: 'info' });
      setTerminalHistory(newHist);
    } else {
      newHist.push({ text: `zsh: command not found: ${cmd}`, type: 'error' });
      setTerminalHistory(newHist);
    }

    setCurrentCommand('');
  };

  const handleAiSend = (e) => {
    e.preventDefault();
    if (!aiPrompt.trim()) return;

    const userMsg = {
      id: Date.now(),
      sender: 'user',
      text: aiPrompt,
      time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    };

