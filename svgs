      const assistantMsg = {
        id: Date.now() + 1,
        sender: 'assistant',
        time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        review: [
          {
            title: 'Code Analysis',
            text: 'I parsed your query logic in `unit1.pas`. SQLite string matching with LIKE is efficient.'
          }
        ],
        conclusion: 'Suggested Refactoring: Wrap database transaction commits inside a try-finally block.'
      };
      setChatMessages((prev) => [...prev, assistantMsg]);
    }, 1000);
  };

