    StatusLabel: TLabel;
    SQLite3Connection1: TSQLite3Connection;
    SQLTransaction1: TSQLTransaction;
    SQLQuery1: TSQLQuery;
    DataSource1: TDataSource;
    procedure FormCreate(Sender: TObject);
    procedure SearchButtonClick(Sender: TObject);
    procedure DataSource1Click(Sender: TObject);
  private
    procedure Search(const Pattern: string);
  public
  end;

var
  Form1: TForm1;

implementation

{$R *.lfm}

{ TForm1 }

procedure TForm1.FormCreate(Sender: TObject);
begin
  SQLite3Connection1.DatabaseName := 'ideas.sqlite3';
  SQLite3Connection1.Connected := True;
  SQLTransaction1.Active := True;
  StatusLabel.Caption := 'Database Ready';
end;

procedure TForm1.Search(const Pattern: string);
begin
  try
    SQLQuery1.Close;
    SQLQuery1.SQL.Text := 'SELECT id, text, done FROM ideas WHERE text LIKE :pat';
    SQLQuery1.Params.ParamByName('pat').AsString := '%' + Pattern + '%';
    SQLQuery1.Open;
    StatusLabel.Caption := Format('Found %d records', [SQLQuery1.RecordCount]);
  except
    on E: Exception do
      StatusLabel.Caption := 'Error: ' + E.Message;
  end;
end;

procedure TForm1.SearchButtonClick(Sender: TObject);
begin
  Search(FilterEdit.Text);
end;

procedure TForm1.DataSource1Click(Sender: TObject);
begin
  // Handle grid selection change
end;

end.`;

