                    }`}
                  >
                    <Icons.FileCode className="w-3.5 h-3.5 text-blue-400" />
                    <span>{tab}</span>
                    <button
                      onClick={(e) => closeTab(tab, e)}
                      className="opacity-0 group-hover:opacity-100 p-0.5 rounded hover:bg-white/10 text-slate-400 hover:text-white transition"
                    >
                      <Icons.X className="w-3 h-3" />
                    </button>
                  </div>
                );
              })}
            </div>

            <div className="flex-1 flex overflow-auto font-mono text-xs leading-relaxed p-4 bg-[#0f1115]">
              <div className="pr-4 text-slate-600 select-none text-right font-mono min-w-[2.5rem] border-r border-white/5">
                {(activeTab === 'unit1.lfm' ? lfmCode : pascalCode).split('\n').map((_, index) => (
                  <div key={index + 1}>{index + 1}</div>
                ))}
              </div>

              <div className="pl-4 flex-1 text-slate-300 overflow-x-auto">
                {(activeTab === 'unit1.lfm' ? lfmCode : pascalCode).split('\n').map((line, index) => {
                  const isKeyword = line.match(/^\s*(unit|interface|uses|type|class|private|public|implementation|procedure|begin|end|var|try|except|on|do)\b/i);
                  const isString = line.includes("'");
                  const isComment = line.trim().startsWith('{') || line.trim().startsWith('//');

                  return (
                    <div 
                      key={index} 
                      className={`whitespace-pre hover:bg-white/[0.03] px-1 rounded transition ${
                        index === 18 ? 'bg-blue-500/10 border-l-2 border-blue-500 -ml-1 pl-2' : ''
                      }`}
                    >
                      {isComment ? (
                        <span className="text-slate-500 italic">{line}</span>
                      ) : isKeyword ? (
                        <span>
                          <span className="text-purple-400 font-semibold">{line.split(' ')[0]}</span>
                          <span className="text-slate-300">{line.substring(line.split(' ')[0].length)}</span>
                        </span>
                      ) : isString ? (
                        <span className="text-emerald-400">{line}</span>
                      ) : (
                        <span>{line}</span>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>

            {/* Bottom Dock */}
            {showBottomPanel && (
              <div className="h-56 bg-[#14161b] border-t border-white/10 flex flex-col shrink-0">
                <div className="h-8 border-b border-white/5 px-4 flex items-center justify-between bg-[#191b21]">
                  <div className="flex items-center space-x-4 text-xs font-medium">
                    {[
                      { id: 'terminal', label: 'Terminal', icon: Icons.Terminal },
                      { id: 'problems', label: 'Problems (0)', icon: Icons.AlertTriangle },
                      { id: 'output', label: 'Output', icon: Icons.Cpu },
                      { id: 'debug', label: 'Debug Console', icon: Icons.Bug }
                    ].map((tab) => {
                      const IconComponent = tab.icon;
                      const isActive = bottomTab === tab.id;
                      return (
                        <button
                          key={tab.id}
                          onClick={() => setBottomTab(tab.id)}
                          className={`flex items-center space-x-1.5 py-1 transition ${
                            isActive ? 'text-blue-400 border-b-2 border-blue-400' : 'text-slate-400 hover:text-slate-300'
                          }`}
                        >
                          <IconComponent className="w-3.5 h-3.5" />
                          <span>{tab.label}</span>
                        </button>
                      );
                    })}
                  </div>

                  <div className="flex items-center space-x-2 text-xs text-slate-500">
                    <button onClick={() => setTerminalHistory([])} title="Clear console" className="hover:text-slate-300 transition">
                      <Icons.Trash2 className="w-3.5 h-3.5" />
                    </button>
                    <button onClick={() => setShowBottomPanel(false)} title="Minimize panel" className="hover:text-slate-300 transition">
                      <Icons.X className="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>

                <div className="flex-1 p-3 font-mono text-xs overflow-y-auto bg-[#0d0e11] text-slate-300">
                  {bottomTab === 'terminal' && (
                    <div className="space-y-1">
                      {terminalHistory.map((item, idx) => (
                        <div 
                          key={idx} 
                          className={
                            item.type === 'error' ? 'text-rose-400' :
                            item.type === 'success' ? 'text-emerald-400' :
                            item.type === 'command' ? 'text-slate-100 font-semibold' : 'text-slate-400'
                          }
                        >
                          {item.text}
                        </div>
                      ))}
                      <form onSubmit={handleCommandSubmit} className="flex items-center space-x-2 pt-1">
                        <span className="text-emerald-400 font-semibold">richardleurs@Mac-mini db-demo %</span>
                        <input
                          type="text"
                          value={currentCommand}
                          onChange={(e) => setCurrentCommand(e.target.value)}
                          placeholder="Type command ('help', 'fpc', 'clear')..."
                          className="flex-1 bg-transparent border-none outline-none text-slate-100 font-mono text-xs focus:ring-0 p-0"
                        />
                      </form>
                      <div ref={terminalEndRef} />
                    </div>
                  )}

                  {bottomTab === 'problems' && (
                    <div className="flex flex-col items-center justify-center h-full text-slate-500 space-y-2">
                      <Icons.CheckCircle className="w-6 h-6 text-emerald-500" />
                      <span>No problems detected in workspace</span>
                    </div>
                  )}
                </div>
              </div>
            )}
          </main>

          {/* Right Assistant Sidebar */}
          {showRightSidebar && (
            <aside className="w-80 bg-[#14161b]/90 border-l border-white/5 flex flex-col justify-between shrink-0">
              <div className="p-3 border-b border-white/5 flex items-center justify-between bg-[#191b21]">
                <div className="flex items-center space-x-2">
                  <Icons.Sparkles className="w-4 h-4 text-blue-400 animate-pulse" />
                  <span className="font-semibold text-xs text-slate-200">Assistant</span>
                  <span className="text-[10px] bg-blue-500/10 text-blue-400 px-1.5 py-0.5 rounded border border-blue-500/20 font-mono">
                    Ollama
                  </span>
                </div>
                <div className="flex items-center space-x-1">
                  <button className="p-1 hover:bg-white/5 rounded text-slate-400 hover:text-slate-200 transition">
                    <Icons.Trash2 className="w-3.5 h-3.5" />
                  </button>
                  <button onClick={() => setShowRightSidebar(false)} className="p-1 hover:bg-white/5 rounded text-slate-400 hover:text-slate-200 transition">
                    <Icons.X className="w-3.5 h-3.5" />
                  </button>
                </div>
              </div>

              <div className="flex-1 p-3 overflow-y-auto space-y-4">
                {chatMessages.map((msg) => (
                  <div key={msg.id} className="space-y-2">
                    {msg.sender === 'user' ? (
                      <div className="bg-blue-600/20 border border-blue-500/30 rounded-lg p-3 ml-4">
                        <div className="flex items-center justify-between text-[10px] text-blue-400 font-mono mb-1">
                          <span>You</span>
                          <span>{msg.time}</span>
                        </div>
                        <p className="text-xs text-slate-200">{msg.text}</p>
                      </div>
                    ) : (
                      <div className="bg-white/5 border border-white/10 rounded-lg p-3 space-y-3">
                        <div className="flex items-center justify-between text-[10px] text-slate-400 font-mono">
                          <span className="flex items-center space-x-1 text-purple-400">
                            <Icons.Sparkles className="w-3 h-3" />
                            <span>Review & Insights</span>
                          </span>
                          <span>{msg.time}</span>
                        </div>

                        {msg.review && (
                          <div className="space-y-2">
                            {msg.review.map((item, i) => (
                              <div key={i} className="text-xs bg-black/20 p-2 rounded border border-white/5">
                                <div className="font-semibold text-slate-200 mb-0.5 flex items-center space-x-1">
                                  <Icons.ChevronRight className="w-3 h-3 text-blue-400" />
                                  <span>{item.title}</span>
                                </div>
                                <p className="text-slate-400 text-[11px] leading-relaxed">{item.text}</p>
                              </div>
                            ))}
                          </div>
                        )}

                        {msg.conclusion && (
                          <div className="pt-2 border-t border-white/5 text-xs text-slate-300">
                            <span className="font-semibold text-slate-200">Conclusion: </span>
                            <span className="text-slate-400">{msg.conclusion}</span>
                          </div>
                        )}
                      </div>
                    )}
                  </div>
                ))}
              </div>

              <div className="p-3 border-t border-white/5 bg-[#191b21]/60 space-y-2">
                <div className="flex items-center justify-between text-[11px]">
                  <label className="flex items-center space-x-2 text-slate-400 cursor-pointer">
                    <input 
                      type="checkbox" 
                      checked={allowEdits} 
                      onChange={(e) => setAllowEdits(e.target.checked)}
                      className="rounded bg-white/10 border-white/20 text-blue-500 focus:ring-0" 
                    />
                    <span>Allow edits this session</span>
                  </label>

                  <select 
                    value={selectedModel}
                    onChange={(e) => setSelectedModel(e.target.value)}
                    className="bg-white/5 border border-white/10 rounded px-2 py-0.5 text-[10px] text-slate-300 focus:outline-none font-mono"
                  >
                    <option value="gemma4:e2b-mix" className="bg-[#14161b]">gemma4:e2b-mix</option>
                    <option value="llama3.1:8b" className="bg-[#14161b]">llama3.1:8b</option>
                  </select>
                </div>

                <form onSubmit={handleAiSend} className="relative">
                  <textarea
                    rows={2}
                    placeholder="Ask the assistant..."
                    value={aiPrompt}
                    onChange={(e) => setAiPrompt(e.target.value)}
                    className="w-full bg-white/5 border border-white/10 rounded-lg p-2 pr-8 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-blue-500/50 resize-none"
                  />
                  <button
                    type="submit"
                    className="absolute right-2 bottom-2.5 p-1 bg-blue-600 hover:bg-blue-500 text-white rounded-md transition"
                  >
                    <Icons.Send className="w-3 h-3" />
                  </button>
                </form>
              </div>
            </aside>
          )}

        </div>
      </div>
    </div>
  );
}
