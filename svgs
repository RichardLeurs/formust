  const pascalCode = `unit Unit1;

{$mode objfpc}{$H+}

interface

uses
  Classes, SysUtils, Forms, Controls, Graphics, Dialogs, 
  StdCtrls, DBGrids, DB, SQLDB, SQLite3Conn;

type
  { TForm1 }
